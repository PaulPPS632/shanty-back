# ---- Servidor ----
# Puerto donde escucha Express. Opcional, default 3000.
PORT=3000

# ---- Base de datos (PostgreSQL) ----
# Requeridos: sin estos el pool de pg falla al conectar.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_DATABASE=personas
# Opcional, default 5432.
DB_PORT=5432

# ---- API externa de campanias (AWS API Gateway) ----
# Bearer token para GetCampaniasDisponiblesByNumeroDocumento.
# Si queda vacio, /api/campaigns responde 401 desde el servicio externo.
EXTERNAL_CAMPAIGNS_TOKEN=

# ---- Logs ----
# trace | debug | info | warn | error | fatal | silent. Default: info.
# En debug entran las rutas de relleno (ubigeo, photo-cached) y, si LOG_SQL=true,
# el SQL de Sequelize.
LOG_LEVEL=info
# pretty = una linea legible y con color para `docker logs -f`. json = NDJSON para
# pasarselo a jq o a un colector. Default: pretty.
LOG_FORMAT=pretty
# Vuelca el SQL de Sequelize al log en nivel debug. Default: false.
# Solo para una sesion de diagnostico: con 37M filas las consultas son enormes.
LOG_SQL=false

# ---- CORS ----
# Origenes permitidos, separados por coma. Vacio = se refleja el que venga (el
# comportamiento de antes). Ej: https://miapp.vercel.app,http://localhost:3000
CORS_ORIGINS=

# ---- Proxy ----
# Numero de saltos de proxy en los que confiar para sacar la IP real de
# X-Forwarded-For. En el VPS hay uno (nginx/caddy) -> 1. 'false' desactiva.
# El proxy tiene que mandar X-Forwarded-For, o req.ip sale como 172.x.
TRUST_PROXY=1

# ---- Auth (Supabase) ----
# off     = no se verifica nada, todo pasa, el log dice user=anon
# log     = se verifica; si falla la peticion PASA IGUAL y el log dice por que.
#           Es el default: permite desplegar el backend antes que el frontend.
# enforce = si falla, 401.
AUTH_MODE=log
# URL del proyecto, SIN barra final. De aqui se derivan el issuer y el JWKS.
SUPABASE_URL=https://aalisifaxnocimmdecpf.supabase.co
# Solo si el proyecto sigue en HS256 legacy, es decir si
#   curl -s "$SUPABASE_URL/auth/v1/.well-known/jwks.json"
# devuelve {"keys":[]}. Con claves asimetricas (el caso actual) se deja vacio.
SUPABASE_JWT_SECRET=
# Rutas que nunca piden token, separadas por coma. Prefijo, no exacto.
AUTH_PUBLIC_PATHS=/api/health

# ---- Creditos (Supabase) ----
# off     = no se toca nada, ni una llamada a Supabase. Igual que sin creditos.
# log     = se calcula la tarifa y se consulta el saldo, se anota en el log,
#           pero NO se descuenta y NUNCA se responde 402. Para medir antes.
# enforce = reserva -> 402 si no alcanza -> liquidacion. Exige AUTH_MODE=enforce.
CREDITS_MODE=off
# Clave SECRETA de Supabase: Settings -> API Keys -> Secret keys (sb_secret_...).
# NO es la publishable. Salta TODAS las policies de RLS y puede usar la Admin
# Auth API: tratar como la contrasena de root. NUNCA en el frontend, NUNCA con
# prefijo NEXT_PUBLIC_, NUNCA en un commit.
SUPABASE_SECRET_KEY=
# Techo por llamada RPC. Default 4000.
SUPABASE_RPC_TIMEOUT_MS=4000
# Si el RPC de creditos falla o expira: true = se sirve la peticion sin cobrar.
# Que Supabase se caiga no deberia tumbar los endpoints que dependen de
# SUNAT/RENIEC/MTPE. /api/foto y /api/utpalumno fallan cerrados igualmente.
CREDITS_FAIL_OPEN=true
# Prefijos que nunca cobran ni gastan un RPC.
CREDITS_FREE_PATHS=/api/health,/api/ubigeo,/api/creditos
# true = cobrar tambien las respuestas >=400 (los 404 de SUNAT/RENIEC si
# consumieron una llamada externa real).
CREDITS_CHARGE_ON_ERROR=false
# Cada cuanto se relee creditos_config.precios desde Supabase.
CREDITS_PRECIOS_TTL_MS=60000
